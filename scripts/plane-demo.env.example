# Configuration for scripts/plane-demo.sh. Copy to scripts/plane-demo.env (git
# ignores it) or anywhere else and pass -c. Every address below is a
# documentation address: put the real endpoints only in the copy.

# The blogs command (make blogs).
BLOGS_BIN=./bin/blogs
# A producer home for the demo alone, and where its archives and run logs go.
DEMO_HOME=$HOME/.blogs-demo
DEMO_DIR=$HOME/blogs-demo

# The chain: main, test or regtest.
BLOGS_NETWORK=regtest
# The node's asset API (proofs, the tip, raw transactions) and JSON-RPC
# (fund, which mines to the fund address, only on a chain you run).
BLOGS_ASSET=http://192.0.2.10:8090
BLOGS_RPC=http://192.0.2.10:9292
# The node's RPC credentials, when it asks for them.
#BLOGS_RPC_USER=
#BLOGS_RPC_PASS=
# The settlement leg: tcp:<host:port>, rpc:<url> or arcade:<url>.
BLOGS_SETTLE=tcp:192.0.2.20:8725
#BLOGS_ARCADE_KEY=
# Where the producer publishes (a host's or a bridge's submit route), and the
# header source every proof is checked against.
BLOGS_FACADE=http://192.0.2.31:9175
BLOGS_HEADER_URL=http://192.0.2.31:9178
BLOGS_TIMEOUT=30s

# The three archive hosts. A and B receive the stream's topic from the
# plane; C is a host process that does not, and is filled by backfill.
ARCHIVE_A=http://192.0.2.31:8080
ARCHIVE_B=http://192.0.2.32:8080
ARCHIVE_C=http://127.0.0.1:18080

# The stream's readable name; setup draws its random suffix once.
STREAM_NAME=demo
# Lines per run, and lines per batch.
DEMO_LINES=40
DEMO_MAX_LINES=8
# Blocks to mine when the pool has no spendable coin.
FUND_BLOCKS=101
# Seconds to wait for A and B to hold the new interval; how long produce and
# anchor wait for an anchor to mine.
DELIVERY_WAIT=180
ANCHOR_WAIT=15m
